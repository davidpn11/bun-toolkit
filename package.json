{
  "name": "bun-toolkit",
  "version": "0.5.0",
  "description": "Bun native APIs straight in your terminal. A modern, configurable CLI that ships as a single binary.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "btk": "bin/btk.ts",
    "bun-toolkit": "bin/btk.ts"
  },
  "exports": {
    ".": "./src/public.ts"
  },
  "types": "./src/public.ts",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun bin/btk.ts",
    "test": "bun test",
    "test:dist": "bun scripts/test-dist.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "bun --check",
    "lint": "oxlint",
    "format": "biome format --write .",
    "check": "biome check . && oxlint && bun --check",
    "release:version": "bun scripts/version-packages.ts",
    "release:try": "bun tests/release/run.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "ansis": "^4.4.0",
    "ink": "^6.8.0",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  }
}
