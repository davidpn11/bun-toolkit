{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!coverage",
      "!**/node_modules",
      "!.claude/worktrees",
      "!website/.next",
      "!website/.source",
      "!website/out",
      "!website/next-env.d.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": true
  }
}
